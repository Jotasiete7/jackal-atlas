# Cache imutável para pirâmides de tiles (somente pastas de tiles)
# Um ano de cache com immutable, garantindo entrega instantânea via CDN e cache local do browser.
/tiles_custom/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/tiles_terrain/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/tiles_iso/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/tiles_topo/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Assets e código da aplicação: revalidação rápida
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

# Cabeçalhos globais de segurança
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow, noarchive
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: https://cdn.discordapp.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://unpkg.com https://cdn.jsdelivr.net https://*.catbox.moe https://litterbox.catbox.moe https://api.imgbb.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none';
